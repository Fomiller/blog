---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listPosts, type Post } from '../lib/directus';
import { formatDate } from '../lib/format';
import { allTags, postsWithTags, selectedTags, tagsOf, toggleQuery } from '../lib/tags';

export const prerender = false;

// A CMS outage should cost the reader the list, not the whole site.
let posts: Post[] = [];
let reachable = true;
try {
  posts = await listPosts();
} catch {
  reachable = false;
}

const tags = allTags(posts);
const selected = selectedTags(Astro.url.searchParams, tags);
const shown = postsWithTags(posts, selected);

const title = selected.length > 0 ? `the garden · ${selected.join(' + ')}` : 'the garden';
---

<BaseLayout
  title={title}
  description="A digital garden: travel, homeownership, cars, technology, programming, cooking."
>
  {
    tags.length > 0 && (
      <nav slot="aside" aria-label="Filter by tag">
        <p class="label">tags</p>
        <ul>
          {tags.map((tag) => (
            <li>
              <a
                href={toggleQuery(selected, tag)}
                class:list={['tag', { on: selected.includes(tag) }]}
                aria-pressed={selected.includes(tag) ? 'true' : 'false'}
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <h1>A place to put things down.</h1>

  <p class="lede">
    Travel, homeownership, cars, technology, programming, cooking. Whatever is
    growing at the time.
  </p>

  {
    shown.length > 0 && (
      <ul class="entries">
        {shown.map((post) => (
          <li>
            <a class="entry" href={`/garden/${post.slug}`}>
              {post.title}
            </a>
            {post.excerpt && <p>{post.excerpt}</p>}
            <p class="meta">
              {formatDate(post.published_at) && <time>{formatDate(post.published_at)}</time>}
              {tagsOf(post).length > 0 && <span>{tagsOf(post).join(' · ')}</span>}
            </p>
          </li>
        ))}
      </ul>
    )
  }

  {
    shown.length === 0 && reachable && selected.length > 0 && (
      <p class="quiet">
        Nothing is tagged {selected.join(' and ')} at once. <a href="/">Start again</a>, or drop a
        tag from the list.
      </p>
    )
  }
  {
    shown.length === 0 && reachable && selected.length === 0 && (
      <p class="quiet">Nothing has come up yet. The beds are dug.</p>
    )
  }
  {!reachable && <p class="quiet">The garden is closed for a moment. Come back shortly.</p>}
</BaseLayout>

<style>
  .label {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: lowercase;
    color: var(--ink-soft);
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .tag {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.875rem;
    border-bottom: 1px solid transparent;
  }

  .tag:hover {
    color: var(--accent);
  }

  .tag.on {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  /* Stacked, the column of tags becomes a wrapping row: a phone should not
     scroll past a tall list to reach the entries. */
  @media (max-width: 46rem) {
    nav ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
  }

  .lede {
    margin-bottom: 3.5rem;
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* A column, and items sized to their own content. Without it the title and
     the date sit on one line whenever an entry has no excerpt between them,
     and the title's rule runs into the date. */
  .entries li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .entry {
    font-size: 1.25rem;
    line-height: 1.3;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid transparent;
  }

  .entry:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .entries p {
    margin: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .quiet {
    color: var(--ink-soft);
  }
</style>

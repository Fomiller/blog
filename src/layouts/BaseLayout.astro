---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

// A page with nothing for the sidebar keeps the plain centred column, rather
// than a two-column grid with an empty gutter in it.
const split = Astro.slots.has('aside');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="data:," />
  </head>
  <body>
    <div class:list={['frame', { wide: split }]}>
      <header>
        <a class="mark" href="/">the garden</a>
      </header>
      <div class:list={['body', { split }]}>
        {
          split && (
            <aside>
              <slot name="aside" />
            </aside>
          )
        }
        <main>
          <slot />
        </main>
      </div>
      <footer>
        <p>Tended slowly. Nothing here is finished.</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --ink: #2f2b26;
    --ink-soft: #6b635a;
    --ground: #faf7f2;
    --line: #e3ddd3;
    --accent: #6d7f6b;
    --measure: 34rem;
    --aside: 9rem;
    --gutter: 3rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #e6e1d8;
      --ink-soft: #9a9187;
      --ground: #1a1917;
      --line: #302d29;
      --accent: #8fa88c;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: ui-serif, Georgia, 'Times New Roman', serif;
    font-size: 1.0625rem;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }

  .frame {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 5rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
    min-height: 100vh;
  }

  /* Wide enough for the sidebar and the gutter on top of the reading measure,
     so the prose keeps the same width it has on a page without one. */
  .frame.wide {
    max-width: calc(var(--measure) + var(--aside) + var(--gutter));
  }

  .body {
    flex: 1;
  }

  .body.split {
    display: grid;
    grid-template-columns: var(--aside) minmax(0, 1fr);
    gap: var(--gutter);
    align-items: start;
  }

  .body.split aside {
    position: sticky;
    top: 5rem;
  }

  /* Below the split width the sidebar stacks above the entries rather than
     squeezing them. Sticky goes with it: a filter pinned to the top of a phone
     screen is just lost height. */
  @media (max-width: 46rem) {
    .body.split {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .body.split aside {
      position: static;
    }
  }

  .mark {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.875rem;
    letter-spacing: 0.16em;
    text-transform: lowercase;
  }

  .mark:hover {
    color: var(--accent);
  }

  h1 {
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.35;
    margin: 0 0 1.5rem;
  }

  a {
    color: var(--accent);
  }

  footer {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }

  footer p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.875rem;
  }
</style>
